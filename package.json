{
  "name": "cookson_pro_api",
  "version": "1.0.0",
  "description": "A simple weather API application",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "node -r dotenv-safe/config server.js",
    "dev": "DEV=true node -r dotenv-safe/config --watch server.js .env",
    "test": "DEV=true LOG_LEVEL=error node -r dotenv-safe/config --test",
    "test-only": "DEV=true LOG_LEVEL=error node -r dotenv-safe/config --test --test-only",
    "test:weather": "DEV=true node -r dotenv-safe/config --test test/weather.js",
    "test:location": "DEV=true node -r dotenv-safe/config --test test/location.js",
    "test:astro": "DEV=true node -r dotenv-safe/config --test test/astro.js",
    "test:sunmoon": "DEV=true node -r dotenv-safe/config --test test/sunmoon.js",
    "test:tonight": "DEV=true node -r dotenv-safe/config --test test/tonight.js",
    "build": "npm install --omit=dev",
    "build_lambda": "npm install --omit=dev && zip -qr lambda.zip handler.js package.json node_modules lib"
  },
  "dependencies": {
    "astronomia": "4.2.0",
    "astronomy-engine": "2.1.19",
    "aws-serverless-express": "3.4.0",
    "cors": "2.8.6",
    "dotenv": "17.2.1",
    "dotenv-safe": "9.1.0",
    "express": "5.2.1",
    "ipaddr.js": "2.5.0",
    "namespaced-console-logger": "1.1.0",
    "satellite.js": "7.1.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/client-secrets-manager": "3.1146.0",
    "supertest": "7.3.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1"
  },
  "author": "",
  "license": "ISC"
}
